# URL pública definitiva (canonical, sitemap, JSON-LD, OG, llms.txt)
NEXT_PUBLIC_SITE_URL=https://hubfuse.com.br

# ---------- Keystatic (painel de conteúdo em /keystatic) ----------
# local  → desenvolvimento (padrão). Em produção, o painel fica desativado neste modo.
# github → produção, login com conta GitHub
# cloud  → produção, login pelo Keystatic Cloud
NEXT_PUBLIC_KEYSTATIC_STORAGE=local

# Obrigatório no modo github (ex.: fuse-agencia/site)
# NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Criadas automaticamente pelo assistente do Keystatic no modo github:
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ---------- Formulário de contato → Google Sheets (ver docs/leads-planilha.md) ----------
# Sem a URL, em desenvolvimento o lead só aparece no terminal.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# ---------- Antispam Cloudflare Turnstile (opcional, recomendado) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
